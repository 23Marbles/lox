class Foo {
  init(arg) {
    print "Foo.init(" + arg + ")";
    this.field = "init";
  }
}

var foo = Foo("one"); // prints: Foo.init(one)
foo.field = "field";

var foo2 = foo.init("two"); // prints: Foo.init(two)
print foo2; // prints: <Foo instance>

// Make sure init() doesn't create a fresh instance.
print foo.field; // prints: init
