// Bound methods have identity equality.
class Foo {}
class Bar {}

print Foo == Foo; // prints: "true"
print Foo == Bar; // prints: "false"
print Bar == Foo; // prints: "false"
print Bar == Bar; // prints: "true"

print Foo == "Foo"; // prints: "false"
print Foo == nil;   // prints: "false"
print Foo == 123;   // prints: "false"
print Foo == true;  // prints: "false"
