// * has higher precedence than +.
print 2 + 3 * 4; // prints: "14"

// * has higher precedence than -.
print 20 - 3 * 4; // prints: "8"

// / has higher precedence than +.
print 2 + 6 / 3; // prints: "4"

// / has higher precedence than -.
print 2 - 6 / 3; // prints: "0"

// < has higher precedence than ==.
print false == 2 < 1; // prints: "true"

// > has higher precedence than ==.
print false == 1 > 2; // prints: "true"

// <= has higher precedence than ==.
print false == 2 <= 1; // prints: "true"

// >= has higher precedence than ==.
print false == 1 >= 2; // prints: "true"

// 1 - 1 is not space-sensitive.
print 1 - 1; // prints: "0"
print 1 -1;  // prints: "0"
print 1- 1;  // prints: "0"
print 1-1;   // prints: "0"

// Using () for grouping.
print (2 * (6 - (2 + 2))); // prints: "4"
