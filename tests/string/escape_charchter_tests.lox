// prints: carriage\rreturn
print "carriage\rreturn";
// prints: return
// prints: newline
print "return\r\nnewline";
// prints: new
// prints: line
print "new\nline";
// prints: tab\ttab
print "tab\ttab";
// prints: "string"
print "\"string\"";
// prints: \\
print "\\";
// prints: \\\\
print "\\\\";
// prints: \\n
print "\\n";
// prints: \\z
print "\z";
