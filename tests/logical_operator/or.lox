// Note: These tests implicitly depend on ints being truthy.

// Return the first true argument.
print 1 or true; // prints: "1"
print false or 1; // prints: "1"
print false or false or true; // prints: "true"

// Return the last argument if all are false.
print false or false; // prints: "false"
print false or false or false; // prints: "false"

// Short-circuit at the first true argument.
var a = "before";
var b = "before";
(a = false) or
    (b = true) or
    (a = "bad");
print a; // prints: "false"
print b; // prints: "true"
